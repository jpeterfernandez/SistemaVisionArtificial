# Cardinova Vision & Production System Configuration
# ====================================================

# Environment
PROJECT_NAME="Cardinova Control de Producción y Visión Artificial"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"

# CORS (comma-separated origins)
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]

# Database PostgreSQL
# Default local Docker setup:
DATABASE_URL="postgresql+psycopg://admin:admin@localhost:5432/cardinova_core_platform"
DB_ECHO=False

# JWT Security
SECRET_KEY="cardinova-production-super-secret-jwt-key-replace-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480
# Required outside development. Generate a separate long random value.
ODOO_ENCRYPTION_KEY=""

# YOLO Vision
YOLO_MODEL_PATH="best.pt"
YOLO_CONF_THRESHOLD=0.60
YOLO_IOU_THRESHOLD=0.45
YOLO_IMG_SIZE=640
YOLO_STREAM_IMG_SIZE=416
YOLO_DEVICE="auto"
YOLO_CPU_EXTRA_THREADS=1
YOLO_GPU_MEMORY_FRACTION=0.85

# Storage for inference artifacts (if saving enabled)
STORAGE_DIR="storage"
SAVE_INFERENCE_IMAGES=False

# Odoo ERP Integration (Configure when credentials are confirmed)
ODOO_BASE_URL="http://localhost:8069"
ODOO_DATABASE="odoo_cardinova"
ODOO_USERNAME="admin"
ODOO_API_KEY=""
ODOO_TIMEOUT=10
ODOO_SYNC_INTERVAL_SECONDS=30
CAMERA_HEALTH_CHECK_INTERVAL_SECONDS=30
